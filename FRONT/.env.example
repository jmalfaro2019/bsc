# API base URL (defaults to /api — proxied by Vite in dev, see vite.config.ts)
VITE_API_URL=/api

# Muestra la pestaña "Estructura" (/admin/estructura) para administradores.
# Debe quedar SIN definir (o "false") en producción: la pestaña está en
# revisión (validaciones de ponderaciones y restricciones pendientes).
# Activar solo en entornos de desarrollo/pruebas (Vercel Preview o .env.development).
VITE_SHOW_ADMIN_STRUCTURE=true
