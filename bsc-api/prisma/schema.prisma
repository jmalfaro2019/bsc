generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id @default(cuid())
  username String   @unique
  password String
  role     String   @default("lector")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Perspective {
  id        String    @id @default(cuid())
  name      String
  objective String
  weightage Float
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  projects Project[]

  @@map("perspectives")
}

model Project {
  id           String   @id @default(cuid())
  name         String
  weightage    Float
  strategy     String
  detail       String
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  perspectiveId String     @map("perspective_id")
  perspective   Perspective @relation(fields: [perspectiveId], references: [id], onDelete: Cascade)

  activities Activity[]

  @@map("projects")
}

model Activity {
  id                  String   @id @default(cuid())
  name                String
  weightage           Float
  progress            Float    @default(0)
  responsibleProcess  String   @map("responsible_process")
  complianceDate      String   @map("compliance_date")
  realizedActivities  String   @default("") @map("realized_activities")
  order               Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  progressRecords ProgressRecord[]
  avanceItems     AvanceItem[]

  @@map("activities")
}

model ProgressRecord {
  id          String   @id @default(cuid())
  activityId  String
  progress    Float
  recordedAt  DateTime @default(now()) @map("recorded_at")
  snapshotId  String?  @map("snapshot_id")

  activity Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  snapshot Snapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([activityId, recordedAt])
  @@index([snapshotId])
  @@map("progress_records")
}

model Snapshot {
  id        String   @id @default(cuid())
  label     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  progressRecords ProgressRecord[]
  avances         Avance[]

  @@map("snapshots")
}

model Avance {
  id         String       @id @default(cuid())
  snapshotId String?      @map("snapshot_id")
  snapshot   Snapshot?    @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  date       DateTime     @default(now())
  createdAt  DateTime     @default(now()) @map("created_at")
  items      AvanceItem[]

  @@index([snapshotId])
  @@map("avances")
}

model AvanceItem {
  id          String   @id @default(cuid())
  avanceId    String   @map("avance_id")
  avance      Avance   @relation(fields: [avanceId], references: [id], onDelete: Cascade)
  activityId  String   @map("activity_id")
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  progress    Float
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([avanceId])
  @@map("avance_items")
}